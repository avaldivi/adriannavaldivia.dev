---
interface Props {
  title: string;
}

const { title, } = Astro.props;
---

<section class="hero">
  <div style="height: 40vmin; min-height: 360px">
    <script
      is:inline
      src="https://cdn.jsdelivr.net/ghost/signup-form@~0.3/umd/signup-form.min.js"
      data-label-1="adriannavaldivia.dev-signup"
      data-background-color="#08090c"
      data-text-color="#FFFFFF"
      data-button-color="#d6749b"
      data-button-text-color="#FFFFFF"
      data-title="Celestial Doses"
      data-description="Astrology and Tech"
      data-site="https://www.celestialdoses.com/"
      data-locale="en"
      async></script>
  </div>
</section>

<style>
  .hero {
    padding: 4rem 0;
  }
</style>